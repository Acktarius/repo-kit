#!/usr/bin/env python3
"""hermesVPS vulnerability intelligence collector — CLI shim.

Delegates to hermes_vps_intel.main(). All endpoint configuration is
centralized in lib/hermes_vps_intel.py — do not duplicate URLs here.

Normal operator walkthrough: invoked automatically by Hermes as part of
the phase-040 task instructions. Do not call directly unless debugging.

Usage:
  hermes-vps-collect-intel --run-json PATH --output PATH [options]

Options:
  --mode live|imported|not-authorized  (default: not-authorized)
  --packages-json PATH                 JSON: [{ecosystem,name,version},...]
  --import-evidence PATH               Required for --mode imported
  --freshness-hours N                  Override default 24h threshold
  --nvd-api-key-env VAR                Env var name for NVD API key (never logged)
  --fixture-dir DIR                    Test mode: read fixture responses, no network

Exit codes:
  0   Success
  1   Invocation or I/O error
"""
import os
import sys

# Prevent __pycache__ writes under the policy tree; must precede the lib import.
sys.dont_write_bytecode = True

_EXT_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if _EXT_ROOT not in sys.path:
    sys.path.insert(0, _EXT_ROOT)

from lib.hermes_vps_intel import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
