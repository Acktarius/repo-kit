{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hermesVPS findings export",
  "description": "Machine-readable findings snapshot for handoff to a remediation agent. Generated by 'hermes-vps-artifacts generate-findings'. Immutable once registered. Not a substitute for the target repository's canonical security/findings-reviewed.json; migration requires separate validation and authorization.",
  "type": "object",
  "required": [
    "schema_version", "generated_at_utc", "run_id", "source_commit",
    "source_identity", "complete", "selected_artifact_ids", "coverage",
    "readiness", "findings", "dismissed_candidates"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "generated_at_utc": {
      "type": "string",
      "description": "ISO-8601 UTC timestamp of export generation"
    },
    "run_id": { "type": "string" },
    "source_commit": {
      "type": "string",
      "description": "Full 40-char lowercase hex SHA of the inspected source commit; must equal run.json source.commit",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_identity": { "type": "string" },
    "toolkit_revision": { "type": ["string", "null"] },
    "complete": {
      "type": "boolean",
      "description": "True only when all candidates from the triage inventory have current valid assessments. A partial export must not be described as a complete remediation handoff."
    },
    "selected_artifact_ids": {
      "type": "object",
      "description": "Exact artifact IDs used as input to this export",
      "required": ["060", "070", "080"],
      "properties": {
        "060": { "type": ["string", "null"] },
        "070": {
          "type": "object",
          "description": "subject-scoped: {candidate_id: artifact_id} for the assessments actually used",
          "additionalProperties": { "type": "string" }
        },
        "080": {
          "type": "object",
          "description": "subject-scoped: {candidate_id: artifact_id} for the current, non-stale plans actually used",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": ["total_candidates", "assessed", "missing_assessments", "stale_assessments", "complete"],
      "properties": {
        "total_candidates": { "type": "integer" },
        "assessed": { "type": "integer" },
        "missing_assessments": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Candidate IDs with no current 070 assessment"
        },
        "stale_assessments": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Candidate IDs whose 070 artifact failed integrity, currency, or upstream-staleness checks"
        },
        "incomplete_assessments": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Candidate IDs whose selected 070 artifact is registered as blocked or incomplete"
        },
        "complete": { "type": "boolean" },
        "intel_collected_at_utc": {
          "type": ["string", "null"],
          "description": "UTC timestamp of the phase-040 intelligence collection; null if no 040 payload available"
        },
        "intel_freshness_ok": {
          "type": ["boolean", "null"],
          "description": "True when all checked providers are within the freshness threshold; null if unknown"
        }
      },
      "additionalProperties": false
    },
    "readiness": {
      "type": "object",
      "description": "Multi-field readiness assessment. Do not use a single boolean as the whole readiness model.",
      "properties": {
        "intel": {
          "type": "object",
          "description": "Intelligence artifact and freshness details",
          "properties": {
            "artifact_id": { "type": ["string", "null"] },
            "freshness": {
              "type": "object",
              "description": "Per-provider freshness. Evaluated against retrieved_at_utc, never registration or import time.",
              "properties": {
                "ok": { "type": ["boolean", "null"] },
                "evaluated_at_utc": { "type": ["string", "null"] },
                "effective_threshold_hours": { "type": ["number", "null"] },
                "threshold_source": { "type": ["string", "null"], "enum": ["default", "cli", "run_config", null] },
                "oldest_provider_age_hours": { "type": ["number", "null"] },
                "stale_providers": { "type": "array", "items": { "type": "string" } },
                "unknown_providers": { "type": "array", "items": { "type": "string" } },
                "limitations": { "type": "array", "items": { "type": "string" } },
                "note": { "type": ["string", "null"] }
              }
            },
            "coverage": {
              "type": "object",
              "properties": {
                "osv_status": { "type": ["string", "null"] },
                "nvd_status": { "type": ["string", "null"] },
                "cisa_kev_status": { "type": ["string", "null"] },
                "total_matches": { "type": ["integer", "null"] },
                "kev_matches": { "type": ["integer", "null"] },
                "collection_mode": { "type": ["string", "null"] },
                "collected_at_utc": { "type": ["string", "null"] },
                "limitations": { "type": "array", "items": { "type": "string" } },
                "notes": { "type": ["string", "null"] }
              }
            }
          }
        },
        "assessment": {
          "type": "object",
          "description": "Assessment completeness (separate from intel freshness)",
          "properties": {
            "complete": { "type": "boolean" },
            "missing_assessments": { "type": "array", "items": { "type": "string" } },
            "stale_assessments": { "type": "array", "items": { "type": "string" } },
            "incomplete_assessments": { "type": "array", "items": { "type": "string" } }
          }
        },
        "provenance_080": {
          "type": "object",
          "description": "Phase-080 plan provenance checks",
          "properties": {
            "findings_with_plans": { "type": "integer" },
            "stale_plans": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Candidate IDs whose selected 080 plan is stale (superseded 040/060/070 input, hash mismatch, or not complete); such plans are excluded"
            }
          }
        },
        "readiness_ok": {
          "type": "boolean",
          "description": "True only when assessment is complete, intel is fresh, and no selected 080 plan is stale"
        },
        "policy_check_failed": {
          "type": "boolean",
          "description": "True when --require-fresh-intel was set and freshness check failed. Export is still valid; this records that the policy gate was triggered."
        },
        "limitations": {
          "type": "array",
          "items": { "type": "string" },
          "description": "All readiness limitations aggregated"
        }
      }
    },
    "findings": {
      "type": "array",
      "description": "Assessed findings with confirmed/suspected/needs-investigation dispositions",
      "items": {
        "type": "object",
        "required": [
          "candidate_id", "assessment_disposition", "proposed_record", "source_artifact"
        ],
        "properties": {
          "candidate_id": { "type": "string" },
          "finding_id": {
            "type": ["string", "null"],
            "description": "Stable SG-NNN ID if assigned; null for new findings"
          },
          "assessment_disposition": {
            "type": "string",
            "enum": ["confirmed", "suspected", "needs-investigation", "blocked"]
          },
          "assessment_rationale": { "type": ["string", "null"] },
          "proposed_record": {
            "type": "object",
            "description": "Canonical-schema-compatible finding record (subset of fields from finding-record.schema.json proposed_finding)",
            "required": ["title", "status", "severity", "files"],
            "properties": {
              "id": { "type": ["string", "null"] },
              "title": { "type": "string" },
              "status": {
                "type": "string",
                "description": "Must not be 'fixed' merely because a remediation plan artifact exists",
                "enum": ["open", "fixed", "accepted-risk", "duplicate", "rejected"]
              },
              "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
              "confidence": { "type": ["string", "null"], "enum": ["low", "medium", "high", null] },
              "firstSeen": { "type": ["string", "null"] },
              "lastReviewed": { "type": ["string", "null"] },
              "source": { "type": ["string", "null"] },
              "files": { "type": "array", "items": { "type": "string" } },
              "summary": { "type": ["string", "null"] },
              "exploitPath": { "type": ["string", "null"] },
              "remediation": { "type": ["string", "null"] },
              "duplicateOf": { "type": ["string", "null"] },
              "acceptedRiskId": { "type": ["string", "null"] },
              "notes": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          },
          "affected_components": { "type": "array", "items": { "type": "string" } },
          "impact": { "type": ["string", "null"] },
          "likelihood": { "type": ["string", "null"], "enum": ["low", "medium", "high", null] },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["description"],
              "properties": {
                "description": { "type": "string" },
                "file": { "type": ["string", "null"] },
                "line": { "type": ["integer", "null"] },
                "excerpt": { "type": ["string", "null"] }
              },
              "additionalProperties": false
            }
          },
          "unknowns": { "type": "array", "items": { "type": "string" } },
          "blockers": { "type": "array", "items": { "type": "string" } },
          "source_artifact": { "type": "string" },
          "source_commit": { "type": ["string", "null"] },
          "remediation_plan_artifact": {
            "type": ["string", "null"],
            "description": "Phase-080 plan artifact ID if available; presence does not imply the finding is fixed"
          },
          "_note": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "dismissed_candidates": {
      "type": "array",
      "description": "Candidates assessed as dismissed or rejected",
      "items": {
        "type": "object",
        "required": ["candidate_id", "disposition", "source_artifact"],
        "properties": {
          "candidate_id": { "type": "string" },
          "disposition": {
            "type": "string",
            "enum": ["dismissed", "rejected"]
          },
          "rationale": { "type": ["string", "null"] },
          "source_artifact": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
